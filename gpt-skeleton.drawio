        </mxCell>
        <mxCell id="-tMHPxVwaKHQxEQfK2Ct-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fontSize=19;arcSize=3;" value="To decrease the loss of the transformer in the model we are using Adamw optimizer&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;AdamW is an optimizer that updates model weights using adaptive learning rates and proper weight decay, making it ideal for training large neural networks like Transformers.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Apart from Adamw there is another optimizer called SGD&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;h1 data-start=&quot;755&quot; data-end=&quot;772&quot;&gt;SGD vs AdamW&lt;/h1&gt;&lt;br/&gt;&lt;div class=&quot;TyagGW_tableContainer&quot;&gt;&lt;div tabindex=&quot;-1&quot; class=&quot;group TyagGW_tableWrapper flex flex-col-reverse w-fit&quot;&gt;&lt;table data-start=&quot;774&quot; data-end=&quot;1103&quot; class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead data-start=&quot;774&quot; data-end=&quot;799&quot;&gt;&lt;tr data-start=&quot;774&quot; data-end=&quot;799&quot;&gt;&lt;th data-start=&quot;774&quot; data-end=&quot;784&quot; data-col-size=&quot;sm&quot; class=&quot;&quot;&gt;Feature&lt;/th&gt;&lt;th data-start=&quot;784&quot; data-end=&quot;790&quot; data-col-size=&quot;sm&quot; class=&quot;&quot;&gt;SGD&lt;/th&gt;&lt;th data-start=&quot;790&quot; data-end=&quot;799&quot; data-col-size=&quot;sm&quot; class=&quot;&quot;&gt;AdamW&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-start=&quot;823&quot; data-end=&quot;1103&quot;&gt;&lt;tr data-start=&quot;823&quot; data-end=&quot;891&quot;&gt;&lt;td data-start=&quot;823&quot; data-end=&quot;839&quot; data-col-size=&quot;sm&quot;&gt;Learning rate&lt;/td&gt;&lt;td data-start=&quot;839&quot; data-end=&quot;865&quot; data-col-size=&quot;sm&quot;&gt;Same for all parameters&lt;/td&gt;&lt;td data-start=&quot;865&quot; data-end=&quot;891&quot; data-col-size=&quot;sm&quot;&gt;Adaptive per parameter&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;892&quot; data-end=&quot;934&quot;&gt;&lt;td data-start=&quot;892&quot; data-end=&quot;915&quot; data-col-size=&quot;sm&quot;&gt;Speed of convergence&lt;/td&gt;&lt;td data-start=&quot;915&quot; data-end=&quot;924&quot; data-col-size=&quot;sm&quot;&gt;Slower&lt;/td&gt;&lt;td data-start=&quot;924&quot; data-end=&quot;934&quot; data-col-size=&quot;sm&quot;&gt;Faster&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;935&quot; data-end=&quot;977&quot;&gt;&lt;td data-start=&quot;935&quot; data-end=&quot;947&quot; data-col-size=&quot;sm&quot;&gt;Stability&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;947&quot; data-end=&quot;962&quot;&gt;Needs tuning&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;962&quot; data-end=&quot;977&quot;&gt;More stable&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;978&quot; data-end=&quot;1041&quot;&gt;&lt;td data-start=&quot;978&quot; data-end=&quot;989&quot; data-col-size=&quot;sm&quot;&gt;Used for&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;989&quot; data-end=&quot;1019&quot;&gt;Vision models (ResNet etc.)&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1019&quot; data-end=&quot;1041&quot;&gt;Transformers / NLP&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1042&quot; data-end=&quot;1103&quot;&gt;&lt;td data-start=&quot;1042&quot; data-end=&quot;1057&quot; data-col-size=&quot;sm&quot;&gt;Weight decay&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1057&quot; data-end=&quot;1066&quot;&gt;Manual&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1066&quot; data-end=&quot;1103&quot;&gt;Built-in (correct implementation)&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
